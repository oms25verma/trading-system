HTTP_ADDR=:8080
BROKER=paper

KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

TRADE_STORE_PATH=data
POLL_SECONDS=5
SYNC_POLL_SECONDS=0
LOG_LEVEL=info
ERROR_LOG_PATH=data/error.log

DEFAULT_PRODUCT=MIS
DEFAULT_QUANTITY=1
DEFAULT_MARKET_PROTECTION=-1
DEFAULT_STOP_LOSS_POINTS=10
DEFAULT_TARGET_POINTS=10
DEFAULT_SL_LIMIT_OFFSET=0.5
REQUIRE_ORDER_PROTECTION=false

# Watchlist order-entry enforcement is parked for now. Dynamic Kite instrument
# sync is the preferred source for option contracts and lot sizes.
# SYMBOL_WATCHLIST_FILE=config/symbols.json
ENFORCE_SYMBOL_WATCHLIST=false

# Fallback quick format if SYMBOL_WATCHLIST_FILE is empty:
# SYMBOL_WATCHLIST=NSE:INFY:MIS,MCX:SILVERM26JUNFUT:MIS
